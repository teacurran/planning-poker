<?xml version="1.0" encoding="UTF-8"?>
<!--
    Mock SAML2 Response for Integration Testing Documentation

    This file is for REFERENCE ONLY - integration tests use MockSsoAdapter
    to avoid parsing actual SAML XML. This example shows the structure of
    a typical SAML2 assertion from an IdP like Azure AD or Okta.

    Structure:
    - Response: Root element containing status and assertion
    - Assertion: Contains subject, conditions, signature, attributes
    - Signature: XML digital signature (not validated in mock tests)
    - Subject: User identifier (NameID)
    - Conditions: Validity period (NotBefore/NotOnOrAfter) and audience
    - AttributeStatement: User attributes (email, name, groups)
-->
<samlp:Response xmlns:samlp="urn:oasis:names:tc:SAML:2.0:protocol"
                xmlns:saml="urn:oasis:names:tc:SAML:2.0:assertion"
                ID="_mock-response-id-12345"
                Version="2.0"
                IssueInstant="2026-01-18T10:00:00Z"
                Destination="https://app.scrumpoker.com/api/v1/auth/sso/callback">

    <!-- Status indicates successful authentication -->
    <samlp:Status>
        <samlp:StatusCode Value="urn:oasis:names:tc:SAML:2.0:status:Success"/>
    </samlp:Status>

    <!-- Assertion contains user identity and attributes -->
    <saml:Assertion xmlns:saml="urn:oasis:names:tc:SAML:2.0:assertion"
                    ID="_mock-assertion-id-67890"
                    Version="2.0"
                    IssueInstant="2026-01-18T10:00:00Z">

        <!-- Issuer identifies the IdP -->
        <saml:Issuer>https://acmecorp.okta.com/saml2</saml:Issuer>

        <!-- Signature (not validated in mock tests) -->
        <Signature xmlns="http://www.w3.org/2000/09/xmldsig#">
            <SignedInfo>
                <CanonicalizationMethod Algorithm="http://www.w3.org/2001/10/xml-exc-c14n#"/>
                <SignatureMethod Algorithm="http://www.w3.org/2001/04/xmldsig-more#rsa-sha256"/>
                <Reference URI="#_mock-assertion-id-67890">
                    <Transforms>
                        <Transform Algorithm="http://www.w3.org/2000/09/xmldsig#enveloped-signature"/>
                        <Transform Algorithm="http://www.w3.org/2001/10/xml-exc-c14n#"/>
                    </Transforms>
                    <DigestMethod Algorithm="http://www.w3.org/2001/04/xmlenc#sha256"/>
                    <DigestValue>MOCK_DIGEST_VALUE_BASE64==</DigestValue>
                </Reference>
            </SignedInfo>
            <SignatureValue>MOCK_SIGNATURE_VALUE_BASE64==</SignatureValue>
            <KeyInfo>
                <X509Data>
                    <X509Certificate>MOCK_CERTIFICATE_BASE64==</X509Certificate>
                </X509Data>
            </KeyInfo>
        </Signature>

        <!-- Subject identifies the authenticated user -->
        <saml:Subject>
            <saml:NameID Format="urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified">
                https://acmecorp.okta.com/users/john.doe
            </saml:NameID>
            <saml:SubjectConfirmation Method="urn:oasis:names:tc:SAML:2.0:cm:bearer">
                <saml:SubjectConfirmationData
                    NotOnOrAfter="2026-01-18T10:05:00Z"
                    Recipient="https://app.scrumpoker.com/api/v1/auth/sso/callback"/>
            </saml:SubjectConfirmation>
        </saml:Subject>

        <!-- Conditions define validity period and audience -->
        <saml:Conditions NotBefore="2026-01-18T09:55:00Z"
                         NotOnOrAfter="2026-01-18T10:05:00Z">
            <saml:AudienceRestriction>
                <saml:Audience>https://app.scrumpoker.com</saml:Audience>
            </saml:AudienceRestriction>
        </saml:Conditions>

        <!-- AttributeStatement contains user profile data -->
        <saml:AttributeStatement>
            <saml:Attribute Name="email" NameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic">
                <saml:AttributeValue xmlns:xs="http://www.w3.org/2001/XMLSchema"
                                     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                                     xsi:type="xs:string">
                    john.doe@acmecorp.com
                </saml:AttributeValue>
            </saml:Attribute>

            <saml:Attribute Name="displayName" NameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic">
                <saml:AttributeValue xmlns:xs="http://www.w3.org/2001/XMLSchema"
                                     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                                     xsi:type="xs:string">
                    John Doe
                </saml:AttributeValue>
            </saml:Attribute>

            <saml:Attribute Name="groups" NameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic">
                <saml:AttributeValue xmlns:xs="http://www.w3.org/2001/XMLSchema"
                                     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                                     xsi:type="xs:string">
                    Users
                </saml:AttributeValue>
                <saml:AttributeValue xmlns:xs="http://www.w3.org/2001/XMLSchema"
                                     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                                     xsi:type="xs:string">
                    Developers
                </saml:AttributeValue>
            </saml:Attribute>
        </saml:AttributeStatement>
    </saml:Assertion>
</samlp:Response>

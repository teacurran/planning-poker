---
// Testimonials section (placeholder content)
const testimonials = [
  {
    quote: "Planning Poker has transformed how our distributed team handles sprint planning. The real-time sync is flawless.",
    author: "Sarah Johnson",
    role: "Scrum Master, Tech Corp",
    avatar: "SJ",
  },
  {
    quote: "We tried several tools, but this is by far the easiest to use. No setup, no friction, just estimate and go.",
    author: "Michael Chen",
    role: "Product Owner, StartupXYZ",
    avatar: "MC",
  },
  {
    quote: "The analytics features in the Pro plan give us incredible insights into our estimation accuracy and team velocity.",
    author: "Emily Rodriguez",
    role: "Engineering Manager, Enterprise Co",
    avatar: "ER",
  },
];
---

<section class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <!-- Section header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Loved by Agile Teams Worldwide
      </h2>
      <p class="text-xl text-gray-600">
        Join 1,000+ teams who trust Planning Poker for their estimation sessions
      </p>
    </div>

    <!-- Testimonials grid -->
    <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {testimonials.map((testimonial) => (
        <div class="bg-gray-50 p-8 rounded-xl border border-gray-200">
          {/* Quote */}
          <div class="mb-6">
            <svg class="w-10 h-10 text-primary-200 mb-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>
            <p class="text-gray-700 leading-relaxed">
              "{testimonial.quote}"
            </p>
          </div>

          {/* Author */}
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-primary-600 text-white rounded-full flex items-center justify-center font-semibold">
              {testimonial.avatar}
            </div>
            <div>
              <div class="font-semibold text-gray-900">{testimonial.author}</div>
              <div class="text-sm text-gray-600">{testimonial.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

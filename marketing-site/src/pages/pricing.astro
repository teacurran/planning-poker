---
import BaseLayout from '../layouts/BaseLayout.astro';

// Tier data matching frontend/src/utils/subscriptionUtils.ts exactly
const tiers = [
  {
    name: 'Free',
    price: 0,
    priceLabel: 'Free',
    description: 'Perfect for trying out Planning Poker',
    features: [
      'Basic planning poker functionality',
      'Public rooms only',
      'Basic session summaries',
      '30 days session history',
      'Banner ads',
    ],
    cta: 'Get Started',
    ctaLink: 'https://app.planningpoker.example.com/signup',
    recommended: false,
  },
  {
    name: 'Pro',
    price: 10,
    priceLabel: '$10/month',
    description: 'For professional teams and power users',
    features: [
      'All Free features',
      'Ad-free experience',
      'Advanced reports with round-level detail',
      'User consistency metrics',
      'CSV/JSON/PDF export',
      '90 days session history',
    ],
    cta: 'Upgrade to Pro',
    ctaLink: 'https://app.planningpoker.example.com/pricing',
    recommended: true,
  },
  {
    name: 'Pro Plus',
    price: 30,
    priceLabel: '$30/month',
    description: 'Enhanced privacy and control',
    features: [
      'All Pro features',
      'Invite-only rooms',
      'Enhanced privacy controls',
      'Priority support',
    ],
    cta: 'Upgrade to Pro Plus',
    ctaLink: 'https://app.planningpoker.example.com/pricing',
    recommended: false,
  },
  {
    name: 'Enterprise',
    price: null,
    priceLabel: 'Contact Sales',
    description: 'For organizations with advanced needs',
    features: [
      'All Pro Plus features',
      'Organization management',
      'SSO integration (OIDC/SAML2)',
      'Audit logging',
      'Organization-wide analytics',
      'Organization-restricted rooms',
      'Unlimited session history',
      'Dedicated support',
    ],
    cta: 'Contact Sales',
    ctaLink: 'mailto:sales@planningpoker.example.com',
    recommended: false,
  },
];

const faqs = [
  {
    question: 'Can I change plans later?',
    answer: 'Yes! You can upgrade or downgrade your plan at any time. Upgrades take effect immediately, and downgrades apply at the end of your current billing period.',
  },
  {
    question: 'What payment methods do you accept?',
    answer: 'We accept all major credit cards (Visa, Mastercard, American Express, Discover) through our secure payment processor, Stripe. Enterprise customers can also pay via invoice.',
  },
  {
    question: 'Is there a free trial?',
    answer: 'Our Free plan is available forever with no credit card required. You can upgrade to Pro or Pro Plus at any time to access advanced features.',
  },
  {
    question: 'What happens if I cancel my subscription?',
    answer: 'If you cancel your subscription, you will retain access to your paid features until the end of your current billing period. After that, your account will automatically downgrade to the Free plan.',
  },
  {
    question: 'Do you offer discounts for annual billing?',
    answer: 'Yes! Annual subscriptions receive a 20% discount compared to monthly billing. Contact our sales team for volume discounts on Enterprise plans.',
  },
  {
    question: 'Can I export my data?',
    answer: 'Yes! Pro and higher plans include CSV, JSON, and PDF export functionality for all your session data. Free plan users can upgrade at any time to export their data.',
  },
];
---

<BaseLayout
  title="Pricing - Planning Poker"
  description="Choose the perfect Planning Poker plan for your team. Start free and upgrade as you grow. Flexible pricing from $0 to enterprise."
>
  <!-- Header -->
  <section class="py-16 bg-gradient-to-br from-primary-600 to-secondary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        Choose Your Plan
      </h1>
      <p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto">
        Unlock powerful features and take your planning poker sessions to the next level
      </p>
    </div>
  </section>

  <!-- Pricing tiers -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {tiers.map((tier) => (
          <div class={`relative rounded-xl border-2 ${tier.recommended ? 'border-primary-600 shadow-2xl' : 'border-gray-200 shadow-md'} p-8 flex flex-col`}>
            {tier.recommended && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 bg-primary-600 text-white text-sm font-semibold rounded-full">
                Recommended
              </div>
            )}

            <div class="flex-grow">
              <h3 class="text-2xl font-bold text-gray-900 mb-2">{tier.name}</h3>
              <div class="mb-4">
                {tier.price !== null ? (
                  <div class="text-4xl font-bold text-gray-900">
                    ${tier.price}
                    <span class="text-lg text-gray-600">/month</span>
                  </div>
                ) : (
                  <div class="text-2xl font-bold text-gray-900">{tier.priceLabel}</div>
                )}
              </div>
              <p class="text-gray-600 mb-6">{tier.description}</p>

              <ul class="space-y-3 mb-8">
                {tier.features.map((feature) => (
                  <li class="flex items-start gap-2">
                    <svg class="w-5 h-5 text-green-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span class="text-gray-700">{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href={tier.ctaLink}
              class={`block w-full px-6 py-3 rounded-lg font-semibold transition-colors text-center ${
                tier.recommended
                  ? 'bg-primary-600 text-white hover:bg-primary-700'
                  : 'bg-gray-100 text-gray-800 hover:bg-gray-200'
              }`}
            >
              {tier.cta}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-12 text-center">
          Frequently Asked Questions
        </h2>

        <div class="space-y-6">
          {faqs.map((faq) => (
            <div class="bg-white rounded-lg p-6 shadow-md">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">
                {faq.question}
              </h3>
              <p class="text-gray-600 leading-relaxed">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>

        <div class="mt-12 text-center p-8 bg-primary-50 rounded-xl border border-primary-200">
          <h3 class="text-xl font-semibold text-gray-900 mb-3">
            Still have questions?
          </h3>
          <p class="text-gray-600 mb-4">
            Our team is here to help you choose the right plan for your needs.
          </p>
          <a
            href="mailto:support@planningpoker.example.com"
            class="inline-block px-6 py-3 bg-primary-600 text-white rounded-lg font-semibold hover:bg-primary-700 transition-colors"
          >
            Contact Support
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20 bg-gradient-to-br from-primary-600 to-secondary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        Ready to Get Started?
      </h2>
      <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
        Start with our free plan today. No credit card required.
      </p>
      <a
        href="https://app.planningpoker.example.com/signup"
        class="inline-block px-8 py-4 bg-white text-primary-700 rounded-lg font-semibold hover:bg-gray-100 transition-colors text-lg shadow-lg"
      >
        Sign Up Free
      </a>
    </div>
  </section>
</BaseLayout>
